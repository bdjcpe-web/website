// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  email             String    @unique
  passwordHash      String
  emailVerified     DateTime?
  verificationToken String?   @unique
  createdAt         DateTime  @default(now())
  isMember          Boolean   @default(false)
  filiere           String?
  registeredYear    Int?
  qrToken           String?   @unique
  qrTokenAt         DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  bookings          Booking[]
  esportPlayers     Player[]
  tickets           Ticket[]
}

model Booking {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  startTime String   // "14:00"
  endTime   String   // "16:00"
  status          String    @default("CONFIRMED")
  agreedToRules   Boolean   @default(false)
  rulesAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
}

model EsportTeam {
  id      String   @id @default(cuid())
  game    String   @unique
  name    String
  players Player[]
}

model Player {
  id            String      @id @default(cuid())
  teamId        String
  team          EsportTeam  @relation(fields: [teamId], references: [id])
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  name          String
  role          String
  isSub         Boolean     @default(false)
  gameId        String?
  profileLink   String?
  rankTier      String?
  rankDivision  String?
  createdAt     DateTime    @default(now())
}

model PendingMember {
  email     String   @id @unique
  createdAt DateTime @default(now())
}

model Ticket {
  id            String   @id @default(cuid()) // L'ID unique qui servira de QR Code
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  eventSlug     String   // Pour lier le ticket à l'événement HelloAsso/Calendar
  amount        Int      // Prix en centimes
  paymentStatus String   @default("PAID")
  scanned       Boolean  @default(false) // Pour le jour J : savoir si le billet a été validé à l'entrée
  scannedAt     DateTime?
  createdAt     DateTime @default(now())
}

/**
 * 🕐 Créneaux disponibles gérés par admin
 * dayOfWeek: 1=Lundi, 2=Mardi, 3=Mercredi, 4=Jeudi, 5=Vendredi
 * isActive: true = visible aux utilisateurs, false = désactivé par admin
 * Unique sur (dayOfWeek, startTime, endTime) pour éviter les doublons
 */
model AvailableSlot {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 1-5 (Lun-Ven)
  startTime String   // "08:00"
  endTime   String   // "10:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, startTime, endTime])
}

/**
 * 📅 Créneaux ponctuels pour une date précise (admin only)
 * Coexiste avec les AvailableSlots hebdomadaires.
 * Permet d'ajouter un créneau exceptionnel pour un jour donné.
 */
model DateOverrideSlot {
  id        String   @id @default(cuid())
  date      DateTime // La date précise (stockée en UTC minuit local)
  startTime String   // "08:00"
  endTime   String   // "10:00"
  createdAt DateTime @default(now())

  @@unique([date, startTime, endTime])
}